---
import Base from '../layouts/Base.astro';
import { appOrigin, getEnv } from '../lib/config';
import { confirmSubscriber } from '../lib/subscribers';

const token = Astro.url.searchParams.get('token') ?? '';
const env = getEnv();
const result = token ? await confirmSubscriber(env, env.DB, token, appOrigin(Astro.request, env)) : { ok: false as const };
---

<Base title="Confirm subscription · CF-Email-Groups" narrow>
  <div class="container-narrow" style="margin:4rem auto">
    <div class="card card-body center">
      {result.ok ? (
        <>
          <div style="font-size:2.2rem" aria-hidden="true">✅</div>
          <h1 style="font-size:1.5rem">Subscription confirmed</h1>
          <p class="muted">
            You're on the list{result.groupName ? <> for <strong>{result.groupName}</strong></> : null}. You'll receive
            an email whenever they send an update.
          </p>
          {result.groupSlug ? (
            <p>
              <a class="btn btn-secondary" href={`/join/${result.groupSlug}`}>Manage subscription</a>
            </p>
          ) : null}
        </>
      ) : (
        <>
          <div style="font-size:2.2rem" aria-hidden="true">🤔</div>
          <h1 style="font-size:1.5rem">This link isn't valid any more</h1>
          <p class="muted">
            The confirmation link may have expired, already been used, or the subscription was unsubscribed. You can
            sign up again from the list's public page.
          </p>
          <a class="btn btn-secondary" href="/">Back home</a>
        </>
      )}
    </div>
  </div>
</Base>
